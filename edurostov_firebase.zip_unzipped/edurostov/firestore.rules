rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Все операции идут через серверный SDK (firebase-admin) с полными правами.
    // Прямой доступ с клиента ЗАПРЕЩЁН — сайт работает через tRPC API.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
