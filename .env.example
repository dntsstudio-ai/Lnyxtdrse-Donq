# ─── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_here
OWNER_OPEN_ID=your_open_id_here

# OAuth
VITE_APP_ID=your_oauth_app_id
OAUTH_SERVER_URL=https://your-oauth-server.com
VITE_OAUTH_PORTAL_URL=https://your-oauth-portal.com

# ─── Firebase ─────────────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=edurostov-53ef0

# Вариант 1 — путь к JSON-файлу сервисного аккаунта (рекомендуется для локальной разработки)
FIREBASE_SERVICE_ACCOUNT_PATH=/path/to/serviceAccountKey.json

# Вариант 2 — JSON-строка (рекомендуется для деплоя: Render, Railway, Fly.io)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"edurostov-53ef0",...}

# Вариант 3 — эмулятор Firestore для локальной разработки без Firebase
# FIRESTORE_EMULATOR_HOST=localhost:8080

# ─── Storage (опционально) ───────────────────────────────────────────────────
# BUILT_IN_FORGE_API_URL=
# BUILT_IN_FORGE_API_KEY=

# ─── Analytics (опционально) ─────────────────────────────────────────────────
# VITE_ANALYTICS_ENDPOINT=
# VITE_ANALYTICS_WEBSITE_ID=
